    {
      "parameters": {
        "jsCode": "// ════════════════════════════════════════════\n// NODE 5: Prepare Context + Build System Prompt\n// ════════════════════════════════════════════\n\nconst chat_id      = $('Edit Fields').item.json.chat_id;\nconst user_message = $('Edit Fields').item.json.user_message;\nconst user_name    = $('Edit Fields').item.json.user_name;\n\nconst sheetsData = $('Get row(s) in sheet').all();\nconst lead = sheetsData.length > 0 ? sheetsData[0].json : null;\n\nconst current_stage = lead?.stage || 'STAGE_1';\n\nconst collected_data = lead ? {\n  property_type:  lead.property_type  || null,\n  budget:         lead.budget         || null,\n  area:           lead.area           || null,\n  preferred_date: lead.preferred_date || null\n} : {};\n\nlet conversation_history = [];\ntry {\n  conversation_history = JSON.parse(lead?.conversation_history || '[]');\n  if (conversation_history.length > 10) {\n    conversation_history = conversation_history.slice(-10);\n  }\n} catch(e) {\n  conversation_history = [];\n}\n\nconversation_history.push({\n  role:      'user',\n  content:   user_message,\n  timestamp: new Date().toISOString()\n});\n\nconst system_prompt = `أنت مساعد تأهيل عملاء لوكالة عقارية احترافية. اسمك \"نور\". ردودك باللغة العربية دائماً، ودية ومهنية.\n\nمعلومات العميل الحالية:\n- الاسم: ${user_name}\n- المرحلة الحالية: ${current_stage}\n- البيانات المجمّعة حتى الآن: ${JSON.stringify(collected_data)}\n- سجل المحادثة (آخر 10 رسائل): ${JSON.stringify(conversation_history)}\n\nمراحل التأهيل بالترتيب الصارم:\nSTAGE_1 - رحب بالعميل واسأله عن نوع العقار المطلوب\nSTAGE_2 - اسأل عن الميزانية التقريبية\nSTAGE_3 - اسأل عن المنطقة أو الحي المفضل\nSTAGE_4 - اسأل عن الموعد المفضل للمعاينة\nSTAGE_5 - اشكر العميل وأخبره أن المستشار سيتواصل معه قريباً\nSTAGE_6 - التأهيل مكتمل اضبط qualified على true\n\nقواعد صارمة يجب اتباعها:\n1. سؤال واحد فقط في كل رد لا تجمع أسئلة متعددة أبداً\n2. إذا كان رد العميل غير واضح اطلب التوضيح بلطف وابقَ في نفس المرحلة\n3. إذا رفض العميل تحديد موعد المعاينة سجّل غير محدد وانتقل للمرحلة التالية\n4. لا تطلب رقم الهاتف أبداً التواصل يتم عبر تيليجرام\n5. كن دافئاً وودياً وليس رسمياً جداً\n6. لا تذكر المراحل أو الأرقام للعميل تصرف بشكل طبيعي\n7. عندما تصل لـ STAGE_6 اكتب ملخصاً كاملاً في qualification_summary\n\nيجب أن يكون ردك JSON فقط بدون أي نص إضافي قبله أو بعده بهذا الشكل:\n{\"reply_text\": \"نص الرد الذي سيراه العميل\", \"next_stage\": \"STAGE_X\", \"extracted_data\": {\"property_type\": null, \"budget\": null, \"area\": null, \"preferred_date\": null}, \"qualified\": false, \"qualification_summary\": null}\n\nملاحظات:\n- extracted_data ضع القيمة فقط إذا ذكرها العميل في رسالته الحالية وإلا ضع null\n- qualified true فقط عند STAGE_6\n- qualification_summary اكتبه فقط عند STAGE_6\n\nرسالة العميل الحالية: ${user_message}`;\n\nconst gemini_body = JSON.stringify({\n  contents: [\n    {\n      parts: [\n        {\n          text: system_prompt\n        }\n      ]\n    }\n  ],\n  generationConfig: {\n    temperature: 0.7,\n    maxOutputTokens: 2048,\n    responseMimeType: \"application/json\"\n  }\n});\n\nreturn {\n  chat_id,\n  user_message,\n  user_name,\n  current_stage,\n  collected_data:       JSON.stringify(collected_data),\n  conversation_history: JSON.stringify(conversation_history),\n  is_new_lead:          !lead,\n  system_prompt,\n  gemini_body\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [896, 96],
      "id": "070e1f69-9d7b-47e2-8f7a-d406ed2540a0",
