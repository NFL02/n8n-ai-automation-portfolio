      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [1120, 96],
      "id": "b9928f05-bf50-430a-9f6e-ecb97174073c",
      "name": "HTTP Request",
      "retryOnFail": true,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// ════════════════════════════════════════════\n// NODE 7: Parse AI Response\n// ════════════════════════════════════════════\n\nconst aiResponse = $('HTTP Request').item.json;\nconst context    = $('Code in JavaScript').item.json;\n\nlet responseText = '';\ntry {\n  responseText = aiResponse.candidates[0].content.parts[0].text;\n} catch(e) {\n  responseText = '';\n}\n\nresponseText = responseText\n  .replace(/```json\\n?/g, '')\n  .replace(/```\\n?/g, '')\n  .trim();\n\nconst jsonStart = responseText.indexOf('{');\nconst jsonEnd   = responseText.lastIndexOf('}');\nif (jsonStart !== -1 && jsonEnd !== -1) {\n  responseText = responseText.substring(jsonStart, jsonEnd + 1);\n}\n\nlet parsed;\ntry {\n  parsed = JSON.parse(responseText);\n} catch(e) {\n  parsed = {\n    reply_text:            'عذراً، حدث خطأ تقني مؤقت. هل يمكنك إعادة إرسال رسالتك؟ 🙏',\n    next_stage:            context.current_stage,\n    extracted_data:        {},\n    qualified:             false,\n    qualification_summary: null\n  };\n}\n\nconst existingData = JSON.parse(context.collected_data || '{}');\nconst mergedData   = { ...existingData };\n\nif (parsed.extracted_data) {\n  Object.keys(parsed.extracted_data).forEach(key => {\n    if (\n      parsed.extracted_data[key] !== null &&\n      parsed.extracted_data[key] !== undefined &&\n      parsed.extracted_data[key] !== ''\n    ) {\n      mergedData[key] = parsed.extracted_data[key];\n    }\n  });\n}\n\nlet conversation_history = [];\ntry {\n  conversation_history = JSON.parse(context.conversation_history || '[]');\n} catch(e) {\n  conversation_history = [];\n}\n\nconversation_history.push({\n  role:      'assistant',\n  content:   parsed.reply_text,\n  timestamp: new Date().toISOString()\n});\n\nreturn {\n  chat_id:               context.chat_id,\n  user_name:             context.user_name,\n  reply_text:            parsed.reply_text,\n  next_stage:            parsed.next_stage            || context.current_stage,\n  qualified:             parsed.qualified             || false,\n  qualification_summary: parsed.qualification_summary || null,\n  merged_data:           mergedData,\n  conversation_history:  JSON.stringify(conversation_history),\n  is_new_lead:           context.is_new_lead,\n  timestamp:             new Date().toISOString()\n};"
      },
