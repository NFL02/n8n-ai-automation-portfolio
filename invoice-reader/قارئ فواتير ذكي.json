    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfor (const item of items) {\n  const rawText = item.json.content.parts[0].text;\n  const cleanText = rawText.replace(/```json|```/g, '').trim();\n  const invoiceData = JSON.parse(cleanText);\n  \n  item.json.supplier = invoiceData.supplier;\n  item.json.date = invoiceData.date;\n  item.json.total = invoiceData.total;\n  item.json.products = invoiceData.products;\n}\n\nreturn items;"
      },
