    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfor (const item of items) {\n  const name = item.json.Name;\n  const phone = item.json.Phone;\n  const service = item.json.Service;\n  const time = item.json.PreferredTime;\n  \n  const message = `مرحباً ${name}، استلمنا طلب حجزك لخدمة: ${service} في الوقت: ${time}. سنؤكد لك الموعد قريباً. شكراً لثقتك!`;\n  \n  const encodedMessage = encodeURIComponent(message);\n  const whatsappLink = `https://wa.me/${phone}?text=${encodedMessage}`;\n  \n  item.json.whatsappLink = whatsappLink;\n  item.json.messagePreview = message;\n}\n\nreturn items;"
      },
